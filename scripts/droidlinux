#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
VERSION="0.1.0"

COMMAND="${1:-help}"

case "$COMMAND" in
    start)
        bash "${SCRIPT_DIR}/start.sh"
        ;;
    stop)
        bash "${SCRIPT_DIR}/stop.sh"
        ;;
    restart)
        bash "${SCRIPT_DIR}/restart.sh"
        ;;
    status)
        bash "${SCRIPT_DIR}/status.sh"
        ;;
    apps)
        bash "${ROOT_DIR}/install/apps.sh"
        ;;
    update)
        bash "${SCRIPT_DIR}/update.sh"
        ;;
    repair)
        bash "${SCRIPT_DIR}/repair.sh"
        ;;
    diagnostics)
        bash "${ROOT_DIR}/tools/diagnostics.sh"
        ;;
    benchmark)
        bash "${ROOT_DIR}/tools/benchmark.sh"
        ;;
    uninstall)
        bash "${SCRIPT_DIR}/uninstall.sh"
        ;;
    version|--version|-v)
        echo "DroidLinux-Android-PC"
        echo "Version: ${VERSION}"
        ;;
    help|--help|-h)
        echo "DroidLinux Management CLI"
        echo "Version: ${VERSION}"
        echo "Usage: droidlinux <command>"
        echo ""
        echo "Commands:"
        echo "  start        Start the DroidLinux desktop session"
        echo "  stop         Stop the running desktop session"
        echo "  restart      Restart the desktop session"
        echo "  status       Show system and session status"
        echo "  apps         Manage and view installed applications"
        echo "  update       Update DroidLinux scripts"
        echo "  repair       Repair configuration or broken packages"
        echo "  diagnostics  Collect diagnostic information"
        echo "  benchmark    Run lightweight performance benchmarks"
        echo "  uninstall    Safely uninstall DroidLinux"
        echo "  version      Show DroidLinux version"
        echo "  help         Show this help message"
        ;;
    *)
        echo "Unknown command: $COMMAND"
        echo "Run 'droidlinux help' for usage instructions."
        return 1 2>/dev/null || true
        ;;
esac
